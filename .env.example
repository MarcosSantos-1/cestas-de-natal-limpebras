# Copie para .env.local. Credenciais privadas ficam somente no servidor.
FIREBASE_PROJECT_ID=cesta-de-natal-limpebras
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Gere um segredo com 32 bytes aleatórios. Não altere após importar os dados.
EMPLOYEE_LOOKUP_SECRET=
CAMPAIGN_ID=natal-2026
CAMPAIGN_LABEL=Natal 2026
# UID do usuário criado manualmente no Firebase Authentication.
BOOTSTRAP_ADMIN_UID=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMPLOYEE_ID=
# Agendamento livre a partir de hoje; não exige variáveis de período.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
REQUIRE_APP_CHECK=false
# Somente para testes locais:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# NEXT_PUBLIC_USE_EMULATORS=true
